{
  // Tests run in Node but hand callbacks to the page (page.evaluate), so they see both.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["**/*.ts", "../playwright.config.ts", "../vitest.config.mts", "../src/preload/api.d.ts"]
}
