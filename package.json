{
  "name": "gloom",
  "version": "0.13.1",
  "private": true,
  "description": "A desktop app for Claude Code with nested session folders",
  "author": "SilentGTX",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc -p test/tsconfig.json && tsc -p tools/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "release": "node scripts/release.mjs",
    "spike": "tsx tools/sdk-spike/run.mts",
    "fake-claude:test": "tsx tools/fake-claude/selftest.mts"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.314",
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@electron/fuses": "1.8.0",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "chokidar": "5.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "fractional-indexing": "4.0.0",
    "lucide-react": "1.65.0",
    "motion": "14.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-virtuoso": "4.18.20",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  }
}
